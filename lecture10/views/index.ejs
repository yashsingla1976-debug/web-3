```html
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create User</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/stylesheet/style.css">
</head>

<body>

    <div class="w-full min-h-screen bg-zinc-900 p-10 text-white">

        <div class="nav mb-10">
            <a href="/read" class="text-blue-500">
                Read Users
            </a>
        </div>

        <h1 class="text-3xl tracking-tighter mb-5">
            Create User
        </h1>

        <form action="/create" method="POST">

            <input
                class="px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent"
                type="text"
                name="name"
                placeholder="Name"
                required
            >

            <input
                class="px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent ml-2"
                type="email"
                name="email"
                placeholder="Email"
                required
            >

            <input
                class="px-5 py-2 border-2 border-zinc-800 outline-none rounded-lg bg-transparent ml-2"
                type="text"
                name="image"
                placeholder="Image URL"
            >

            <input
                class="px-5 py-2 bg-blue-500 rounded-lg ml-3 cursor-pointer"
                type="submit"
                value="Create User"
            >

        </form>

    </div>

</body>

</html>
