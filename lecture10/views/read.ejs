<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/stylesheet/style.css">
</head>
<body>
   <div class="w-full h-full bg-zinc-900 text-white"></div>
        <a  class="text-blue-500"href="/">back to home</a>
        <h1 class="text-xl mt-10 tracking-tighter mb-3">All Users</h1>
        <div class=" users flex gap-3 flex-wrap">
            <% if(users.length > 0){
  <% users.forEach(function(user){ %>
                <div class="user w-72 p-4 bg-zinc-800 rounded-lg">
                    <div class="w-full h-52 rounded-lg bg-zinc-700 overflow-hidden"></div>
                        <img  class="w-full h-full object-cover" src=" <%= user.image %>" alt="">
                    <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %>
                    </h3>
                    <h5 class="text-zinc-500"><%= user.email %>
                    </h5>
                    <div class="flex gap-3 mt-10">
                        <a class="text-zinc-200" href="/edit/<%= user._id %>">Edit User</a>
                        <a class="text-red-500"  class ="" href="/delete/<%= user._id %>">Delete User</a>
                    </div>
                </div>
            <%}) %> 


            <%}else{ %>
                <h1 class="text-zinc-500">No Users Found</h1>  
            }%>
</body>
</html>